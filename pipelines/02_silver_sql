
CREATE OR REFRESH MATERIALIZED VIEW silver_billing_deduplicated AS

SELECT
    bill_id,
    visit_id,
    patient_id,
    patient_gender,
    patient_age,
    visit_date,
    visit_type,
    department,
    doctor_name,
    service_category,
    service_name,
    hospital_branch,
    city,
    region,
    payer_type,
    quantity,
    unit_price,
    total_amount,
    insurance_amount,
    payment_status,
    source_file,
    loaded_at

FROM (
    SELECT *,
        ROW_NUMBER() OVER (
            PARTITION BY bill_id
            ORDER BY loaded_at
        ) AS row_num
    FROM bronze_hospital_billing
)
WHERE row_num = 1;

CREATE OR REFRESH MATERIALIZED VIEW silver_billing_clean AS

SELECT
    bill_id,
    visit_id,
    patient_id,

    INITCAP(TRIM(patient_gender)) AS patient_gender,
    patient_age,
    visit_date,
    INITCAP(TRIM(visit_type)) AS visit_type,

    COALESCE(
        INITCAP(TRIM(NULLIF(department, ''))),
        'Unknown'
    ) AS department,

    INITCAP(TRIM(doctor_name)) AS doctor_name,
    INITCAP(TRIM(service_category)) AS service_category,
    INITCAP(TRIM(service_name)) AS service_name,

    TRIM(hospital_branch) AS hospital_branch,
    INITCAP(TRIM(city)) AS city,
    INITCAP(TRIM(region)) AS region,

    COALESCE(
        INITCAP(TRIM(NULLIF(payer_type, ''))),
        'Unknown'
    ) AS payer_type,

    quantity,
    unit_price,

    COALESCE(
        total_amount,
        quantity * unit_price
    ) AS total_amount,

    insurance_amount,
    INITCAP(TRIM(payment_status)) AS payment_status,

    source_file,
    loaded_at

FROM silver_billing_deduplicated

WHERE quantity > 0
  AND unit_price >= 0;


CREATE OR REFRESH MATERIALIZED VIEW silver_billing_rejected AS

SELECT
    *,
    CASE
        WHEN quantity IS NULL OR quantity <= 0
            THEN 'Quantity is zero or negative'

        WHEN unit_price IS NULL OR unit_price < 0
    THEN 'Unit price is missing or negative'

    END AS reject_reason

FROM silver_billing_deduplicated

WHERE quantity IS NULL
   OR quantity <= 0
   OR unit_price IS NULL
   OR unit_price < 0;
